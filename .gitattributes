* text=auto

# Visual Studio and Inno Setup files are happiest with Windows line endings.
*.sln       text eol=crlf
*.vcxproj   text eol=crlf
*.filters   text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.rc        text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.iss       text eol=crlf

*.ico  binary
*.png  binary
*.gif  binary
