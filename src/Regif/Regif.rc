#include <winres.h>

// Application icon shown by Explorer and the taskbar.
1 ICON "Assets\\regif.ico"

// Keep in sync with vcpkg.json when bumping the version. Release builds take their
// installer and zip version from the git tag.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "regif contributors"
            VALUE "FileDescription", "regif - video to GIF converter and GIF editor"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "Regif"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "Regif.exe"
            VALUE "ProductName", "regif"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
