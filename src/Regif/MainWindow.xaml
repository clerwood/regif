<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Regif.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Regif"
    Title="regif">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" PreviewKeyDown="OnRootPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <CommandBar Grid.ColumnSpan="2" HorizontalAlignment="Left" DefaultLabelPosition="Right" Margin="8,4,8,4">
            <AppBarButton x:Name="OpenButton" Icon="OpenFile" Label="Open" Click="OnOpenClick">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="O" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="ExportButton" Icon="Save" Label="Export" Click="OnExportClick" IsEnabled="False">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="S" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="UndoButton" Icon="Undo" Label="Undo" Click="OnUndoClick" IsEnabled="False">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="Z" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="RedoButton" Icon="Redo" Label="Redo" Click="OnRedoClick" IsEnabled="False">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="Y" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="CancelButton" Icon="Cancel" Label="Cancel" Click="OnCancelClick" Visibility="Collapsed" />
        </CommandBar>

        <!-- Preview -->
        <Grid Grid.Row="1" Margin="16,0,8,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="12" />
                    <!-- Same margin as the image, so both lay out in the same box. -->
                    <!-- Text overlays (drawn by FFmpeg) under the crop rectangle; one surface handles both. -->
                    <local:InteractiveSurface
                        x:Name="PreviewSurface"
                        Margin="12"
                        Visibility="Collapsed"
                        SizeChanged="OnPreviewSurfaceSizeChanged"
                        PointerPressed="OnPreviewPointerPressed"
                        PointerMoved="OnPreviewPointerMoved"
                        PointerReleased="OnPreviewPointerReleased"
                        PointerCaptureLost="OnPreviewPointerCaptureLost"
                        DoubleTapped="OnPreviewDoubleTapped">
                        <Grid Background="Transparent">
                            <Canvas x:Name="TextCanvas" IsHitTestVisible="False" />
                            <Canvas x:Name="CropCanvas" IsHitTestVisible="False" />
                            <!-- Holds the in-place text editor while one is open. -->
                            <Canvas x:Name="TextEditCanvas" />
                        </Grid>
                    </local:InteractiveSurface>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="360">
                        <FontIcon Glyph="&#xE714;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Open a video or GIF to start" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Or drop a file here. Every change is saved as a new stage, and your original file is never modified."
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="Open file" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="OnOpenClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ScrubPanel" Grid.Row="1" ColumnSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayButton" Click="OnPlayClick" ToolTipService.ToolTip="Play from the playhead (Space)" AutomationProperties.Name="Play" Visibility="Collapsed">
                    <SymbolIcon x:Name="PlayIcon" Symbol="Play" />
                </Button>
                <!-- Filmstrip, trim handles and playhead; laid out in code (LayoutTimeline). -->
                <local:InteractiveSurface
                    x:Name="TimelineSurface"
                    Grid.Column="1"
                    Height="68"
                    IsTabStop="True"
                    UseSystemFocusVisuals="True"
                    AutomationProperties.Name="Timeline"
                    ToolTipService.ToolTip="Click or drag to seek. Drag the handles to trim, and text clips to move them. Arrow keys step, I and O set the trim points. Double-click a track to add text."
                    SizeChanged="OnTimelineSizeChanged"
                    PointerPressed="OnTimelinePointerPressed"
                    PointerMoved="OnTimelinePointerMoved"
                    PointerReleased="OnTimelinePointerReleased"
                    PointerCaptureLost="OnTimelinePointerCaptureLost"
                    KeyDown="OnTimelineKeyDown"
                    DoubleTapped="OnTimelineDoubleTapped">
                    <Canvas Background="Transparent">
                        <Border x:Name="FilmstripBackground" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" />
                        <Canvas x:Name="FilmstripCanvas" />
                        <Rectangle x:Name="TrimShadeStart" Fill="#B3000000" IsHitTestVisible="False" />
                        <Rectangle x:Name="TrimShadeEnd" Fill="#B3000000" IsHitTestVisible="False" />
                        <Border x:Name="TrimFrame" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="0,3,0,3" IsHitTestVisible="False" />
                        <Border x:Name="TrimHandleStart" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4,0,0,4" IsHitTestVisible="False">
                            <Rectangle Width="2" Height="18" RadiusX="1" RadiusY="1" Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <Border x:Name="TrimHandleEnd" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="0,4,4,0" IsHitTestVisible="False">
                            <Rectangle Width="2" Height="18" RadiusX="1" RadiusY="1" Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <Canvas x:Name="LaneCanvas" IsHitTestVisible="False" />
                        <Rectangle x:Name="Playhead" Width="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource TextFillColorPrimaryBrush}" IsHitTestVisible="False" />
                    </Canvas>
                </local:InteractiveSurface>
                <TextBlock x:Name="PositionText" Grid.Column="2" VerticalAlignment="Center" MinWidth="120" TextAlignment="Right" />
            </Grid>
        </Grid>

        <!-- Edit panel -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Padding="8,0,16,16">
            <StackPanel Spacing="8">
                <TextBlock x:Name="StageTitle" Text="No file open" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="StageDetails" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel x:Name="EditPanel" Spacing="8" Visibility="Collapsed" Margin="0,8,0,0">
                    <Expander
                        x:Name="CropExpander"
                        Header="Crop"
                        IsExpanded="True"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Expanding="OnCropExpanding"
                        Collapsed="OnCropCollapsed">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Drag the rectangle or its handles on the preview, or type the numbers." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="CropAspect" Header="Aspect ratio" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnCropAspectChanged">
                                <x:String>Free</x:String>
                                <x:String>Original</x:String>
                                <x:String>1:1</x:String>
                                <x:String>4:3</x:String>
                                <x:String>3:4</x:String>
                                <x:String>16:9</x:String>
                                <x:String>9:16</x:String>
                            </ComboBox>
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <NumberBox x:Name="CropX" Header="Left" Minimum="0" SpinButtonPlacementMode="Compact" ValueChanged="OnCropValueChanged" />
                                <NumberBox x:Name="CropY" Grid.Column="1" Header="Top" Minimum="0" SpinButtonPlacementMode="Compact" ValueChanged="OnCropValueChanged" />
                                <NumberBox x:Name="CropWidth" Grid.Row="1" Header="Width" Minimum="1" SpinButtonPlacementMode="Compact" ValueChanged="OnCropValueChanged" />
                                <NumberBox x:Name="CropHeight" Grid.Row="1" Grid.Column="1" Header="Height" Minimum="1" SpinButtonPlacementMode="Compact" ValueChanged="OnCropValueChanged" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Crop" Style="{StaticResource AccentButtonStyle}" Click="OnCropClick" />
                                <Button Content="Reset" Click="OnCropResetClick" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="TextExpander" Header="Text" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Text is drawn in when you export, and stays editable until then. Drag it on the preview to move it, and its clip on the timeline to change when it shows." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="TextTrackBox" Header="Track" HorizontalAlignment="Stretch" PlaceholderText="No tracks yet" SelectionChanged="OnTextTrackChanged" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnAddTrackClick" ToolTipService.ToolTip="Add a track">
                                    <SymbolIcon Symbol="Add" />
                                </Button>
                                <Button x:Name="RemoveTrackButton" Grid.Column="2" VerticalAlignment="Bottom" Click="OnRemoveTrackClick" ToolTipService.ToolTip="Remove this track and its text">
                                    <SymbolIcon Symbol="Delete" />
                                </Button>
                            </Grid>
                            <Button Content="Add text at playhead" Style="{StaticResource AccentButtonStyle}" Click="OnAddTextClick" />

                            <StackPanel x:Name="TextClipPanel" Spacing="12" Visibility="Collapsed">
                                <TextBox x:Name="TextContent" Header="Text" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" TextChanged="OnTextContentChanged" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="TextStart" Header="Shows from (s)" Minimum="0" SmallChange="0.1" SpinButtonPlacementMode="Compact" ValueChanged="OnTextNumberChanged" />
                                    <NumberBox x:Name="TextEnd" Grid.Column="1" Header="Until (s)" Minimum="0" SmallChange="0.1" SpinButtonPlacementMode="Compact" ValueChanged="OnTextNumberChanged" />
                                </Grid>
                                <ComboBox x:Name="TextFont" Header="Font" HorizontalAlignment="Stretch" SelectionChanged="OnTextFontChanged" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="TextSize" Header="Size (px)" Minimum="4" Maximum="1000" SmallChange="2" SpinButtonPlacementMode="Compact" ValueChanged="OnTextNumberChanged" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                        <ToggleButton x:Name="TextBold" ToolTipService.ToolTip="Bold" Click="OnTextToggleClick"><FontIcon Glyph="&#xE8DD;" FontSize="14" /></ToggleButton>
                                        <ToggleButton x:Name="TextItalic" ToolTipService.ToolTip="Italic" Click="OnTextToggleClick"><FontIcon Glyph="&#xE8DB;" FontSize="14" /></ToggleButton>
                                        <ToggleButton x:Name="TextAlignLeft" ToolTipService.ToolTip="Align left" Click="OnTextAlignClick" Margin="8,0,0,0"><FontIcon Glyph="&#xE8E4;" FontSize="14" /></ToggleButton>
                                        <ToggleButton x:Name="TextAlignCenter" ToolTipService.ToolTip="Centre" Click="OnTextAlignClick"><FontIcon Glyph="&#xE8E3;" FontSize="14" /></ToggleButton>
                                        <ToggleButton x:Name="TextAlignRight" ToolTipService.ToolTip="Align right" Click="OnTextAlignClick"><FontIcon Glyph="&#xE8E2;" FontSize="14" /></ToggleButton>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Fill" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Padding="4" ToolTipService.ToolTip="Fill colour">
                                        <Border x:Name="FillSwatch" Width="36" Height="20" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                        <Button.Flyout><Flyout><ColorPicker x:Name="FillPicker" IsAlphaEnabled="True" ColorChanged="OnTextColorChanged" /></Flyout></Button.Flyout>
                                    </Button>

                                    <TextBlock Grid.Row="1" Text="Stroke" VerticalAlignment="Center" />
                                    <Button Grid.Row="1" Grid.Column="1" Padding="4" ToolTipService.ToolTip="Stroke colour">
                                        <Border x:Name="StrokeSwatch" Width="36" Height="20" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                        <Button.Flyout><Flyout><ColorPicker x:Name="StrokePicker" IsAlphaEnabled="True" ColorChanged="OnTextColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                    <NumberBox x:Name="StrokeWidth" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" PlaceholderText="Width" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" ValueChanged="OnTextNumberChanged" ToolTipService.ToolTip="Stroke width (px), 0 for none" />

                                    <CheckBox x:Name="BoxEnabled" Grid.Row="2" Content="Box" MinWidth="0" Click="OnTextToggleClick" />
                                    <Button Grid.Row="2" Grid.Column="1" Padding="4" ToolTipService.ToolTip="Box colour">
                                        <Border x:Name="BoxSwatch" Width="36" Height="20" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                        <Button.Flyout><Flyout><ColorPicker x:Name="BoxPicker" IsAlphaEnabled="True" ColorChanged="OnTextColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                    <NumberBox x:Name="BoxPadding" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" PlaceholderText="Padding" Minimum="0" Maximum="200" SpinButtonPlacementMode="Compact" ValueChanged="OnTextNumberChanged" ToolTipService.ToolTip="Box padding (px)" />

                                    <CheckBox x:Name="ShadowEnabled" Grid.Row="3" Content="Shadow" MinWidth="0" Click="OnTextToggleClick" />
                                    <Button Grid.Row="3" Grid.Column="1" Padding="4" ToolTipService.ToolTip="Shadow colour">
                                        <Border x:Name="ShadowSwatch" Width="36" Height="20" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                        <Button.Flyout><Flyout><ColorPicker x:Name="ShadowPicker" IsAlphaEnabled="True" ColorChanged="OnTextColorChanged" /></Flyout></Button.Flyout>
                                    </Button>
                                    <NumberBox x:Name="ShadowX" Grid.Row="3" Grid.Column="2" PlaceholderText="X" Minimum="-100" Maximum="100" SpinButtonPlacementMode="Compact" ValueChanged="OnTextNumberChanged" ToolTipService.ToolTip="Shadow offset right (px)" />
                                    <NumberBox x:Name="ShadowY" Grid.Row="3" Grid.Column="3" PlaceholderText="Y" Minimum="-100" Maximum="100" SpinButtonPlacementMode="Compact" ValueChanged="OnTextNumberChanged" ToolTipService.ToolTip="Shadow offset down (px)" />
                                </Grid>
                                <TextBlock Text="Colours include opacity: use the alpha slider in each colour picker." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Content="Delete this text" Click="OnDeleteTextClick" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="TrimExpander" Header="Trim" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Keep only the part between start and end. Drag the handles at the ends of the timeline to set them." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <NumberBox x:Name="TrimStart" Header="Start (seconds)" Minimum="0" SmallChange="0.1" SpinButtonPlacementMode="Compact" ValueChanged="OnTrimValueChanged" />
                                <NumberBox x:Name="TrimEnd" Grid.Column="1" Header="End (seconds)" Minimum="0" SmallChange="0.1" SpinButtonPlacementMode="Compact" ValueChanged="OnTrimValueChanged" />
                                <HyperlinkButton Grid.Row="1" Content="Use playhead" Tag="TrimStart" Click="OnUsePlayheadClick" />
                                <HyperlinkButton Grid.Row="1" Grid.Column="1" Content="Use playhead" Tag="TrimEnd" Click="OnUsePlayheadClick" />
                            </Grid>
                            <Button Content="Trim" Style="{StaticResource AccentButtonStyle}" Click="OnTrimClick" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Cut" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Remove the part between start and end and join what's left." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <NumberBox x:Name="CutStart" Header="Start (seconds)" Minimum="0" SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                                <NumberBox x:Name="CutEnd" Grid.Column="1" Header="End (seconds)" Minimum="0" SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                                <HyperlinkButton Grid.Row="1" Content="Use playhead" Tag="CutStart" Click="OnUsePlayheadClick" />
                                <HyperlinkButton Grid.Row="1" Grid.Column="1" Content="Use playhead" Tag="CutEnd" Click="OnUsePlayheadClick" />
                            </Grid>
                            <Button Content="Cut" Style="{StaticResource AccentButtonStyle}" Click="OnCutClick" />
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="SpeedExpander" Header="Speed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <NumberBox
                                x:Name="SpeedFactor"
                                Header="Speed (2 = twice as fast, 0.5 = half speed)"
                                Minimum="0.1"
                                Maximum="10"
                                Value="2"
                                SmallChange="0.25"
                                SpinButtonPlacementMode="Compact" />
                            <Button Content="Change speed" Style="{StaticResource AccentButtonStyle}" Click="OnSpeedClick" />
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="ConvertExpander" Header="Convert to GIF" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <NumberBox x:Name="ConvertFps" Header="Frame rate" Minimum="1" Maximum="50" Value="15" SpinButtonPlacementMode="Compact" />
                                <NumberBox x:Name="ConvertWidth" Grid.Column="1" Header="Width (0 = original)" Minimum="0" Value="480" SmallChange="16" SpinButtonPlacementMode="Compact" />
                                <NumberBox x:Name="ConvertColors" Grid.Row="1" Header="Colors" Minimum="2" Maximum="256" Value="256" SpinButtonPlacementMode="Compact" />
                                <ComboBox x:Name="ConvertDither" Grid.Row="1" Grid.Column="1" Header="Dithering" HorizontalAlignment="Stretch" SelectedIndex="3">
                                    <x:String>None</x:String>
                                    <x:String>Bayer (smaller)</x:String>
                                    <x:String>Floyd–Steinberg</x:String>
                                    <x:String>Sierra 2-4A</x:String>
                                </ComboBox>
                            </Grid>
                            <CheckBox x:Name="ConvertLoop" Content="Loop forever" IsChecked="True" />
                            <CheckBox x:Name="ConvertPerFrame" Content="Palette per frame (better color, larger file)" />
                            <Button Content="Convert to GIF" Style="{StaticResource AccentButtonStyle}" Click="OnConvertClick" />
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="OptimizeExpander" Header="Optimize" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Make the GIF smaller with fewer colors, frames or pixels." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <NumberBox x:Name="OptimizeColors" Header="Colors" Minimum="2" Maximum="256" Value="128" SpinButtonPlacementMode="Compact" />
                                <ComboBox x:Name="OptimizeDither" Grid.Column="1" Header="Dithering" HorizontalAlignment="Stretch" SelectedIndex="1">
                                    <x:String>None</x:String>
                                    <x:String>Bayer (smaller)</x:String>
                                    <x:String>Floyd–Steinberg</x:String>
                                    <x:String>Sierra 2-4A</x:String>
                                </ComboBox>
                                <NumberBox x:Name="OptimizeFps" Grid.Row="1" Header="Frame rate (0 = keep)" Minimum="0" Maximum="50" Value="0" SpinButtonPlacementMode="Compact" />
                                <NumberBox x:Name="OptimizeWidth" Grid.Row="1" Grid.Column="1" Header="Width (0 = keep)" Minimum="0" Value="0" SmallChange="16" SpinButtonPlacementMode="Compact" />
                            </Grid>
                            <Button Content="Optimize" Style="{StaticResource AccentButtonStyle}" Click="OnOptimizeClick" />
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <TextBlock x:Name="HistoryHeader" Text="History" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" Visibility="Collapsed" />
                <ListView x:Name="HistoryList" SelectionMode="Single" SelectionChanged="OnHistorySelectionChanged" MaxHeight="280" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="16,0,16,12" Spacing="8">
            <ProgressBar x:Name="BusyProgress" Maximum="100" Visibility="Collapsed" />
            <InfoBar x:Name="StatusBar" IsOpen="False" />
        </StackPanel>
    </Grid>
</Window>
